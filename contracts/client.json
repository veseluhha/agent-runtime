{
  "openapi": "3.1.0",
  "info": {
    "title": "client",
    "version": "0.1.0"
  },
  "paths": {
    "/v0/smoke": {
      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "task_id"
                ],
                "properties": {
                  "task_id": {
                    "type": "string",
                    "description": "Registered simple task ID returned by /v0/tasks"
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "task_id",
                    "trace_id",
                    "repeat",
                    "pair",
                    "pass",
                    "reason",
                    "outcome",
                    "seconds",
                    "tokens_in",
                    "tokens_out",
                    "events"
                  ],
                  "properties": {
                    "task_id": {
                      "type": "string"
                    },
                    "trace_id": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{32}$"
                    },
                    "repeat": {
                      "type": "integer"
                    },
                    "pair": {
                      "type": "string"
                    },
                    "pass": {
                      "type": "boolean"
                    },
                    "reason": {
                      "type": "string"
                    },
                    "outcome": {
                      "type": "string"
                    },
                    "seconds": {
                      "type": "number"
                    },
                    "tokens_in": {
                      "type": "integer"
                    },
                    "tokens_out": {
                      "type": "integer"
                    },
                    "events": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "phase",
                          "tool",
                          "exit_code",
                          "seconds"
                        ],
                        "properties": {
                          "phase": {
                            "type": "string"
                          },
                          "tool": {
                            "type": "string"
                          },
                          "exit_code": {
                            "type": "integer"
                          },
                          "seconds": {
                            "type": "number"
                          }
                        }
                      }
                    },
                    "answer_preview": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "First 1024 bytes of the requested answer, decoded as UTF-8"
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "Failure",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error",
                    "message"
                  ],
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v0/tasks": {
      "post": {
        "summary": "List the runnable simple tasks",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Registered tasks in execution order",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "task_ids"
                  ],
                  "properties": {
                    "task_ids": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "Failure",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error",
                    "message"
                  ],
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "token": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "security": [
    {
      "token": []
    }
  ]
}
